# Supabase config — from Supabase Dashboard -> Project Settings -> API
# EXPO_PUBLIC_* is inlined into the bundle at build time.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SECRET, only for seed/reset scripts, never commit real value.
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
