{
  "random_forest": {
    "n_estimators": 200,
    "max_depth": 15,
    "min_samples_split": 2,
    "min_samples_leaf": 1,
    "random_state": 42,
    "n_jobs": -1
  },
  "train_test_split": {
    "test_size": 0.2,
    "shuffle": false,
    "note": "Chronological split — never shuffle time series data"
  },
  "grid_search": {
    "enabled": true,
    "cv": 3,
    "scoring": "neg_mean_absolute_error",
    "param_grid": {
      "n_estimators": [100, 200, 500],
      "max_depth": [10, 15, 20, null],
      "min_samples_split": [2, 5],
      "min_samples_leaf": [1, 2]
    }
  }
}
