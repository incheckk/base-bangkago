rules_version = '2';

// BangkaGo Firestore security rules.
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste -> Publish.
//
// The seed script uses the Admin SDK, which bypasses these entirely — that is
// why piers and routes can be client-read-only and still get written.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // One extra document read per evaluation. Acceptable at prototype scale;
    // a production build would put the role in a custom auth claim instead.
    function role() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isPassenger() { return signedIn() && role() == 'passenger'; }
    function isBangkero()  { return signedIn() && role() == 'bangkero'; }

    // ---------------------------------------------------------------- users
    // Private. Only the owner ever reads their own contact details.
    match /users/{userId} {
      allow read:   if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['passenger', 'bangkero'];
      // Names only. phone is the account identity — the synthetic auth email is
      // derived from it, so editing it here would desync Firestore from Auth.
      // uid, role, and createdAt are locked for the same reason.
      allow update: if signedIn() && uid() == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['firstName', 'lastName']);
      allow delete: if false;
    }

    // ------------------------------------------------------------ operators
    // Publicly readable to signed-in users on purpose: the passenger home needs
    // a live count of available boats, and an accepted booking shows the boat
    // name. This collection is split from users/ precisely so that lookup
    // cannot leak phone numbers.
    match /operators/{operatorId} {
      allow read:   if signedIn();
      allow create: if signedIn() && uid() == operatorId;
      // Boat details and availability only — uid stays locked.
      allow update: if signedIn() && uid() == operatorId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['boatName', 'capacity', 'isAvailable',
                                   'displayName', 'updatedAt']);
      allow delete: if false;
    }

    // ------------------------------------------------------- piers & routes
    // Reference data. Client-read-only; seeded via Admin SDK.
    match /piers/{pierId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    match /routes/{routeId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ------------------------------------------------------------- bookings
    match /bookings/{bookingId} {

      // Passenger sees their own. Bangkero sees open requests and anything
      // assigned to them. Both app queries are constrained to match.
      allow read: if signedIn() && (
                       resource.data.passengerId == uid()
                    || resource.data.operatorId == uid()
                    || (resource.data.status == 'open' && isBangkero())
                  );

      allow create: if isPassenger()
                    && request.resource.data.passengerId == uid()
                    && request.resource.data.status == 'open'
                    && request.resource.data.operatorId == null
                    && request.resource.data.rejectedBy.size() == 0;

      // Exactly four permitted transitions.
      allow update: if signedIn() && (

        // 1. Passenger cancels their own booking, only while still open.
        (
             resource.data.passengerId == uid()
          && resource.data.status == 'open'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'cancelledAt'])
        )

        // 2. Any available bangkero accepts an open request. First accept wins:
        //    a second attempt finds status != 'open' and is denied.
        || (
             isBangkero()
          && resource.data.status == 'open'
          && request.resource.data.status == 'accepted'
          && request.resource.data.operatorId == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'operatorId', 'operatorName',
                         'operatorBoatName', 'acceptedAt'])
        )

        // 3. Only the assigned bangkero completes the trip.
        || (
             resource.data.operatorId == uid()
          && resource.data.status == 'accepted'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completedAt'])
        )

        // 4. A bangkero declines. This is a write to a booking they do NOT own,
        //    so it is narrowed hard: rejectedBy may only grow by exactly the
        //    caller's own uid, and nothing else may change.
        || (
             isBangkero()
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rejectedBy'])
          && request.resource.data.rejectedBy.hasAll(resource.data.rejectedBy)
          && request.resource.data.rejectedBy.size() == resource.data.rejectedBy.size() + 1
          && uid() in request.resource.data.rejectedBy
        )
      );

      allow delete: if false;
    }
  }
}
