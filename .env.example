# Copy to .env and fill from Supabase Dashboard -> Project Settings -> API.
# Never put real values in this file — it is committed.

# EXPO_PUBLIC_* is inlined into every bundle at build time. The anon key is
# meant to be public; RLS policies are what actually protect the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SECRET. Bypasses every RLS policy — full admin on the database.
# Seed/reset scripts only. Never prefix it EXPO_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
