# Copy to .env and fill from Firebase Console → Project settings → Your apps → Web app.
# EXPO_PUBLIC_* is inlined into the bundle at build time — these are client keys,
# not secrets. Firestore security rules are what actually protect the data.
# The Admin SDK service-account key (Phase 3.10 seed script) is a real secret and
# must never live here.

EXPO_PUBLIC_FB_API_KEY=
EXPO_PUBLIC_FB_AUTH_DOMAIN=
EXPO_PUBLIC_FB_PROJECT_ID=
EXPO_PUBLIC_FB_STORAGE_BUCKET=
EXPO_PUBLIC_FB_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FB_APP_ID=
